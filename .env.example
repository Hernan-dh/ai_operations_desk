# Port exposed by Docker Compose for the application.
APP_PORT=3002
N8N_PORT=5678
# Use false only for local HTTP development. Set true behind production HTTPS.
N8N_SECURE_COOKIE=false

# Required when running `npm start` outside Docker Compose.
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/operations-desk-triage-ai
N8N_TIMEOUT_MS=45000
RATE_LIMIT_PER_MINUTE=60

# Required in production. Generate distinct random values.
CASE_DB_PASSWORD=replace-with-a-long-random-database-password
OPERATOR_KEY=replace-with-a-long-random-operator-key

# Required only by the self-hosted n8n container.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# Optional commit-message generation. Configure one or more providers.
GEMINI_API_KEY=
GEMINI_COMMIT_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_COMMIT_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_COMMIT_MODELS=openrouter/free
COMMIT_GENERATION_TIMEOUT=45
